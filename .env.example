# Base de datos MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=preveo
# Opcional: si tu MySQL escucha por socket Unix en vez de TCP
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock

# Panel de administración (/admin)
ADMIN_PASSWORD=noputas
# Cambiala en producción: firma la cookie de sesión del admin
ADMIN_SECRET=cambiame-por-una-cadena-larga-y-random
